# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing material. Never commit any of these.
#
# `keystore.properties` names the keystore and carries its passwords. The keystore
# itself is the identity every future release is signed with: losing it means the
# app can never be updated on a device that already has it installed, and the only
# way forward would be a new application id.
keystore.properties
*.jks
*.keystore
/android/key.properties

# Local toolchain settings: absolute paths to this machine's Flutter and Android
# SDK, regenerated by the Flutter tool. Machine-specific, so not shared.
/android/local.properties

# Signing and packaging scratch files.
*.tmp
tool/tor_runtime_windows/

# The Tor runtime asset tree. It is filled by tool/stage_tor_runtime.ps1 from
# tor_runtime/<platform>/ immediately before a desktop build and removed again by
# tool/unstage_tor_runtime.ps1. It must never be committed: Flutter bundles every
# declared asset directory into every build on every platform, so a populated
# assets/tor/ is how 119 MB of Windows binaries end up inside an Android APK.
/assets/tor/

# A separate Node.js toolkit that was built in this directory for a different
# purpose. It is not part of DarkFlow, is not referenced by the application, and
# keeping it out of the repository is what makes the tree mean one thing.
/bot/

# Editor and packaging scratch files that are not part of the project.
*.bak
*.orig
*.rej

# Release artifacts. They are built by tool/release.ps1 and attached to a GitHub
# release; committing them would put a 62 MB ZIP and a 45 MB APK in every clone
# for ever, and git would keep every past version of them too.
/dist/

# Scratch files used while writing a commit message.
commit-message.txt
m.txt
