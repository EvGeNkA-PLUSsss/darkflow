<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET is declared here, in the main manifest, and not only in the
         debug and profile ones.

         The Flutter template puts it in those two because the tool needs it for
         hot reload, which means a *release* build would have no network
         permission at all. A Tor messenger that installs and then cannot open a
         socket is the worst possible failure mode, because everything looks
         fine until the first connect. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Voice messages. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Message alerts on Android 13 and later; older releases ignore it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Scanning a contact's QR code. Declared as not required, so a device with
         no camera can still install DarkFlow: the scanner is one way to add a
         contact, not the only one, and a hard requirement would remove the app
         from tablets and from any phone whose camera the user does not want to
         grant. The screen reports a refused permission with the remedy. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <!-- Keeping the connection open while the app is in the background.

         DarkFlow receives over Tor through a daemon inside its own process, so when
         Android reclaims the process there is nothing left to receive with. These two
         permissions are what a foreground service needs, and the service is the only
         mechanism Android offers for "this app has ongoing work the user knows about".

         The service is started only when the user turns the setting on: it shows a
         notification that cannot be dismissed and costs battery, which is a decision
         rather than something to do quietly. -->

    <application
        android:label="DarkFlow"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
