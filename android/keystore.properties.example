# Template for DarkFlow's Android release signing configuration.
#
# Copy this file to `android/keystore.properties` and fill in real values. The
# filled-in file is ignored by git (see the repository .gitignore) and must never
# be committed: it holds the passwords to the key that is this app's identity on
# every Android device that ever installs it.
#
#     Copy-Item android\keystore.properties.example android\keystore.properties
#
# Without `android/keystore.properties` the release build still succeeds, but it
# is signed with the debug key: it cannot be uploaded to a store, and it will not
# upgrade an installation signed with the real key. `tool/build_android.ps1`
# prints a warning in that case.

# Path to the keystore file. Relative paths are resolved against `android/`
# (`rootProject` in Gradle terms), so a keystore sitting next to this file is
# just its name. An absolute path also works.
storeFile=darkflow-release.jks

# The keystore password, and the password for the individual key. These are often
# the same value, but they do not have to be.
storePassword=CHANGE_ME
keyPassword=CHANGE_ME

# The alias of the signing key inside the keystore.
keyAlias=darkflow

# Creating the keystore, once per project:
#
#     keytool -genkeypair -v `
#       -keystore android\darkflow-release.jks `
#       -alias darkflow `
#       -keyalg RSA -keysize 4096 -validity 10000 `
#       -storetype JKS
#
# `keytool` ships with the JDK. Android Studio's bundled one is at
# `C:\Program Files\Android\Android Studio\jbr\bin\keytool.exe`, which is the
# same JDK the build itself uses.
#
# Two things worth deciding before generating it, because neither can be changed
# afterwards:
#
#  * Use a validity long enough to outlive the app's expected life. Google Play
#    requires a key valid until at least 2033; the 10000 days above is about 27
#    years. An expired key cannot sign an update, and the app becomes
#    unmaintainable on devices that have it.
#
#  * Back the keystore up somewhere you will still have it. There is no recovery
#    and no reset: losing it means every existing installation is stranded on the
#    last build it received, because Android refuses an update signed with a
#    different key.
#
# Enrol in Play App Signing instead of uploading this key directly if the app is
# going to Google Play. Play then holds the release key and this keystore becomes
# the *upload* key, which is replaceable if it is lost.
